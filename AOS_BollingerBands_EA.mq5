//+------------------------------------------------------------------+\n//| AOS_BollingerBands_EA.mq5                                        |\n//| Expert Advisor implementing Bollinger Bands trading strategy      |\n//| Author: Eduard Švehla                                            |\n//| Description:                                                      |\n//| Obchodní strategie založená na Bollinger Bands pro MT5          |\n//| SELL: Průnik horním pásmem → návrat do zóny → SELL             |\n//| BUY: Průnik dolním pásmem → návrat do zóny → BUY               |\n//+------------------------------------------------------------------+\n\n#include <Trade\Trade.mqh>\n\n// Vstupní parametry\ninput int BollingerPeriods = 14;        // Periody pro Bollinger Bands\ninput double Deviation = 2.0;           // Odchylka pro Bollinger Bands  \ninput ENUM_TIMEFRAMES TimeFrame = PERIOD_M15; // Timeframe\ninput double LotSize = 0.1;             // Velikost pozice\ninput int MagicNumber = 123456;         // Magické číslo\n\n// Globální proměnné\nint bollingerHandle;\nCTrade trade;\ndouble upperBand[], middleBand[], lowerBand[];\ndouble closePrice[];\nbool wasAboveUpper = false;\nbool wasBelowLower = false;\n\n//+------------------------------------------------------------------+\n//| Expert initialization function                                     |\n//+------------------------------------------------------------------+\nint OnInit() {\n    // Vytvoření handle pro Bollinger Bands\n    bollingerHandle = iBands(_Symbol, TimeFrame, BollingerPeriods, 0, Deviation, PRICE_CLOSE);\n    \n    if(bollingerHandle == INVALID_HANDLE) {\n        Print("Chyba při vytváření Bollinger Bands indikatoru");\n        return INIT_FAILED;\n    }\n    \n    // Nastavení magic number pro trade\n    trade.SetExpertMagicNumber(MagicNumber);\n    \n    // Nastavení arrayů jako sérii\n    ArraySetAsSeries(upperBand, true);\n    ArraySetAsSeries(middleBand, true);  \n    ArraySetAsSeries(lowerBand, true);\n    ArraySetAsSeries(closePrice, true);\n    \n    Print("AOS Bollinger Bands EA inicializován úspěšně");\n    return INIT_SUCCEEDED;\n}\n\n//+------------------------------------------------------------------+\n//| Expert deinitialization function                                   |\n//+------------------------------------------------------------------+\nvoid OnDeinit(const int reason) {\n    // Uvolnění handle\n    if(bollingerHandle != INVALID_HANDLE) {\n        IndicatorRelease(bollingerHandle);\n    }\n    Print("AOS Bollinger Bands EA ukončen");\n}\n\n//+------------------------------------------------------------------+\n//| Expert tick function                                             |\n//+------------------------------------------------------------------+\nvoid OnTick() {\n    // Kontrola, zda už máme pozici\n    if(PositionsTotal() > 0) {\n        return;\n    }\n    \n    // Kopírování dat z indikátoru\n    if(CopyBuffer(bollingerHandle, 1, 0, 3, upperBand) <= 0 ||\n       CopyBuffer(bollingerHandle, 0, 0, 3, middleBand) <= 0 ||\n       CopyBuffer(bollingerHandle, 2, 0, 3, lowerBand) <= 0) {\n        Print("Chyba při kopírování dat z Bollinger Bands");\n        return;\n    }\n    \n    // Kopírování cenových dat\n    if(CopyClose(_Symbol, TimeFrame, 0, 3, closePrice) <= 0) {\n        Print("Chyba při kopírování cenových dat");\n        return;\n    }\n    \n    // Kontrola průniku horním pásmem\n    if(closePrice[1] > upperBand[1]) {\n        wasAboveUpper = true;\n    }\n    \n    // Kontrola průniku dolním pásmem  \n    if(closePrice[1] < lowerBand[1]) {\n        wasBelowLower = true;\n    }\n    \n    // SELL signál - návrat zpět do zóny po průniku horním pásmem\n    if(wasAboveUpper && closePrice[0] <= upperBand[0] && closePrice[0] > middleBand[0]) {\n        double tp = middleBand[0];\n        double distance = closePrice[0] - tp;\n        double sl = closePrice[0] + (distance / 2); // SL na poloviční vzdálenost\n        \n        if(trade.Sell(LotSize, _Symbol, 0, sl, tp, "AOS SELL")) {\n            Print("SELL pozice otevřena: Entry=", closePrice[0], " SL=", sl, " TP=", tp);\n            wasAboveUpper = false;\n        }\n    }\n    \n    // BUY signál - návrat zpět do zóny po průniku dolním pásmem\n    if(wasBelowLower && closePrice[0] >= lowerBand[0] && closePrice[0] < middleBand[0]) {\n        double tp = middleBand[0];\n        double distance = tp - closePrice[0];\n        double sl = closePrice[0] - (distance / 2); // SL na poloviční vzdálenost\n        \n        if(trade.Buy(LotSize, _Symbol, 0, sl, tp, "AOS BUY")) {\n            Print("BUY pozice otevřena: Entry=", closePrice[0], " SL=", sl, " TP=", tp);\n            wasBelowLower = false;\n        }\n    }\n}\n//+------------------------------------------------------------------+